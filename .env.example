# Local Protocol AI — configuration
#
# Copy this file to `.env` and fill in only what you need.
#
#   Windows :  copy .env.example .env
#   bash    :  cp .env.example .env
#
# `.env` is gitignored and must stay that way: it is the one file in this
# project that holds real credentials.
#
# EVERY setting here is optional. With an empty .env the stack still starts:
# the local model runs, the dashboard runs, and the features that need a key
# report that they are unconfigured instead of pretending to work.


# ─────────────────────────────────────────────────────────────────────────────
# THE LOCAL MODEL  —  the only section most people need
# ─────────────────────────────────────────────────────────────────────────────
# The stack talks to an OpenAI-compatible server on your own machine. The
# included launchers start llama.cpp; anything else that speaks the same API
# (LM Studio, vLLM, Ollama's compatible endpoint) works too.
#
# The key is a dummy. A local llama.cpp server does not check it, but the
# OpenAI client library refuses to send a request without one.

OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-dummy-local

# The model name reported to the API. It must match what your server serves —
# the stack warns loudly if you ask for one model and are served another.
LLM_MODEL=gemma-4-26b-qat

# Used by the coding agents. 16 GB of VRAM holds ONE of these at a time, which
# is why the launcher takes a `coder` argument instead of running both.
CODING_MODEL=qwen3-coder-30b

# Optional second endpoint. If you have a machine with more VRAM on the LAN,
# point this at it and the heavier agents will use it. Empty = everything runs
# on the one local server.
MOSKY_LLM2_URL=


# ─────────────────────────────────────────────────────────────────────────────
# WHERE THINGS ARE WRITTEN
# ─────────────────────────────────────────────────────────────────────────────
# The folder the agents are allowed to read and write. Empty = the repo itself.
# This is a real boundary, not a hint: paths outside it are refused.
WORKSPACE_BASE=
OPENHANDS_WORKSPACE=

# Generated websites and generated 3D models. Empty means a folder NEXT TO the
# repository — clone into D:\projects\local-ai and they land in
# D:\projects\generated_sites and D:\projects\generated_models.
#
# These deliberately live outside the repository and the code refuses to start
# if you point them inside it. The agents write arbitrary code into these
# folders, and that code must never be able to reach the engines, the
# launchers, or this .env file.
MOSKY_SITES_ROOT=
MOSKY_MODELS_ROOT=


# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA  —  optional, one key per source
# ─────────────────────────────────────────────────────────────────────────────
# All free tiers. Leave a key empty and that single source reports itself as
# unconfigured; the rest of the stack carries on without it.
#
#   FINNHUB   equities and FX quotes          https://finnhub.io
#   TAVILY    web search for the researcher   https://tavily.com
#   FINLIGHT  financial news                  https://finlight.me
#   MORALIS   on-chain wallet data            https://moralis.io

FINNHUB_API_KEY=
TAVILY_API_KEY=
FINLIGHT_API_KEY=
MORALIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM  —  optional, and OFF unless you fill this in
# ─────────────────────────────────────────────────────────────────────────────
# Only needed if you want briefings delivered to a chat or channel. Nothing is
# ever sent while these are empty: the sender checks for a token first and
# returns "not configured" rather than attempting a delivery.
#
# Treat the token like a password. Anyone holding it can post as your bot.
#
#   BOT_TOKEN   from @BotFather
#   CHAT_ID     your own chat with the bot (send it a message, then read
#               https://api.telegram.org/bot<TOKEN>/getUpdates)
#   CHANNEL_ID  a channel, as @name or the numeric -100… id. The bot must be
#               an administrator of it.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=


# ─────────────────────────────────────────────────────────────────────────────
# UPDATE CHECK
# ─────────────────────────────────────────────────────────────────────────────
# At startup the launcher asks GitHub whether a newer release exists and prints
# what changed. It is bounded, cached for an hour, and silent when there is
# nothing to say — and it never claims you are up to date when it could not
# reach GitHub.
#
# The repository is read from `git remote origin`, so a normal clone needs
# nothing here. Set it only if you run from a tarball or a mirror.

LOCAL_AI_REPO=
LOCAL_AI_UPDATE_INTERVAL=3600
LOCAL_AI_UPDATE_TIMEOUT=4


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL EXTRAS
# ─────────────────────────────────────────────────────────────────────────────
# Each of these belongs to one feature. Ignore any you do not use.

# Document analysis: the language of your documents, and OCR resolution.
# Higher DPI is slower and not always more accurate.
MOSKY_DOC_LANGUAGE=Greek
MOSKY_OCR_DPI=200

# 3D print checking: your printer's usable bed, in millimetres.
PRINTER_BED_X=220
PRINTER_BED_Y=220
PRINTER_BED_Z=250

# Image and video generation, if you run ComfyUI.
COMFYUI_URL=http://127.0.0.1:8188

# Greek speech synthesis: path to a Piper voice model.
PIPER_GREEK_VOICE=

# Signal scoring: how long a trading signal is given to play out, and the
# round-trip cost assumed when scoring it. The cost matters — a strategy that
# looks profitable at 0% fees usually is not.
SIGNAL_EVAL_HORIZON_HOURS=24
SIGNAL_EVAL_COST_PCT=0.2
